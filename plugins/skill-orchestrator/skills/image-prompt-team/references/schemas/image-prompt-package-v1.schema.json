{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ImagePromptPackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "status", "asset_id", "asset_type", "asset_name", "requirement_hash", "design_statement", "generation_prompt", "adapter_profile", "trace", "confirmation"],
  "properties": {
    "schema_version": {"const": "ImagePromptPackageV1"},
    "version": {"type": "string"},
    "status": {"enum": ["proposed", "degraded", "approved"]},
    "asset_id": {"type": "string"},
    "asset_type": {"enum": ["character_master", "location_master", "scene_state", "hero_prop"]},
    "asset_name": {"type": "string"},
    "requirement_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "design_statement": {"type": "string", "minLength": 20},
    "generation_prompt": {"type": "string", "minLength": 80},
    "adapter_profile": {"type": "object", "required": ["id", "version"]},
    "trace": {"type": "object"},
    "confirmation": {"type": ["object", "null"]}
  }
}
