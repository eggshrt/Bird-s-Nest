{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AssetCatalogV1",
  "type": "object",
  "required": ["schema_version", "project", "draft_id", "source_hash", "breakdown_hash", "analyzer_hash", "assets", "ambiguities"],
  "properties": {
    "schema_version": {"const": "AssetCatalogV1"},
    "project": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": ["string", "null"]}}},
    "draft_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "breakdown_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analyzer_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assets": {"type": "array", "items": {"type": "object", "required": ["asset_id", "asset_type", "name", "aliases", "source_refs", "scene_ids", "certainty", "state_candidates"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "asset_type": {"enum": ["character_master", "location_master", "scene_state", "hero_prop"]}, "name": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string"}}, "source_refs": {"type": "array", "items": {"type": "string"}}, "scene_ids": {"type": "array", "items": {"type": "string"}}, "certainty": {"enum": ["explicit", "inferred", "unknown"]}, "state_candidates": {"type": "array", "minItems": 1, "items": {"type": "object"}}}}},
    "ambiguities": {"type": "array", "items": {"type": "object"}}
  }
}
