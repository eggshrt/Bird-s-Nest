{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-script-breakdown/intake.schema.json",
  "title": "AI Script Breakdown Intake",
  "type": "object",
  "required": ["schema_version", "project", "source", "scope"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "required": ["id", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "format": {
          "enum": ["feature", "short", "episode", "vertical_drama"]
        },
        "target_duration_minutes": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "aspect_ratio": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "production_model": {"const": "fully_ai_photoreal_live_action"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "draft_id", "format"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "format": {
          "enum": ["text", "txt", "markdown", "fountain", "fdx", "pdf", "docx"]
        },
        "text": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "previous_draft_path": {"type": ["string", "null"]}
      },
      "oneOf": [
        {"required": ["text"]},
        {"required": ["path"]}
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["requested_role_ids"],
      "properties": {
        "scene_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^scn-[0-9]{3,}$"},
          "uniqueItems": true
        },
        "source_range": {
          "type": ["object", "null"],
          "properties": {
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        "requested_role_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "depth": {
          "enum": ["scene", "beat", "shot_blueprint"]
        }
      },
      "additionalProperties": false
    },
    "custom_roles": {
      "type": "array",
      "items": {"$ref": "#/$defs/roleContract"}
    },
    "options": {
      "type": "object",
      "properties": {
        "diagnosis_mode": {"const": "diagnosis_and_direction_no_rewrite"},
        "compare_drafts": {"type": "boolean"},
        "output_directory": {"type": ["string", "null"]},
        "accepted_extraction_warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "roleContract": {
      "type": "object",
      "required": ["role_id", "display_name", "objective", "questions", "deliverables", "dependencies", "exclusions", "confirmed"],
      "properties": {
        "role_id": {"type": "string", "pattern": "^role-[a-z0-9-]+$"},
        "display_name": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "items": {"type": "string"}},
        "deliverables": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "confirmed": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
