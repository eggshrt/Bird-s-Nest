{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExecutionPlanV1",
  "type": "object",
  "required": ["schema_version", "parallel_authorized", "retry_policy", "nodes"],
  "properties": {
    "schema_version": {"const": "ExecutionPlanV1"},
    "parallel_authorized": {"type": "boolean"},
    "retry_policy": {"type": "object", "required": ["max_replans"], "properties": {"max_replans": {"type": "integer", "minimum": 0, "maximum": 1}}},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "goal", "input_bindings", "expected_outputs", "depends_on", "execution_mode", "risk", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "execution_mode": {"enum": ["serial", "parallel"]},
          "risk": {"enum": ["low", "medium", "high", "critical"]}
        }
      }
    }
  }
}
