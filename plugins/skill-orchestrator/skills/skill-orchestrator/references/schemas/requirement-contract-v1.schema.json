{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RequirementContractV1",
  "type": "object",
  "required": ["schema_version", "goal", "audience", "inputs", "deliverables", "in_scope", "out_of_scope", "constraints", "assumptions", "acceptance_criteria", "open_questions", "retrieval_query", "retrieval_terms"],
  "properties": {
    "schema_version": {"const": "RequirementContractV1"},
    "goal": {"type": "string", "minLength": 1},
    "audience": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["name", "type"]}},
    "deliverables": {"type": "array", "items": {"type": "object", "required": ["name", "type", "required"]}},
    "in_scope": {"type": "array"},
    "out_of_scope": {"type": "array"},
    "constraints": {"type": "array"},
    "assumptions": {"type": "array"},
    "acceptance_criteria": {"type": "array", "items": {"type": "object", "required": ["id", "criterion", "method"]}},
    "open_questions": {"type": "array", "maxItems": 0},
    "retrieval_query": {"type": "string", "pattern": "[A-Za-z0-9]"},
    "retrieval_terms": {"type": "array", "items": {"type": "string"}}
  }
}
