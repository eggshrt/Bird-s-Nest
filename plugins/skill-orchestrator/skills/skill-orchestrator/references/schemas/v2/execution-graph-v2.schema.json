{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExecutionGraphV2",
  "type": "object",
  "required": ["schema_version", "graph_version", "max_concurrency", "max_replans", "nodes"],
  "properties": {
    "schema_version": {"const": "ExecutionGraphV2"},
    "graph_version": {"type": "integer", "minimum": 1},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 3},
    "max_replans": {"enum": [0, 1]},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["node_id", "role_skill", "objective", "input_bindings", "output_schema", "depends_on", "execution_mode", "idempotent", "soft_timeout_seconds", "hard_timeout_seconds", "permissions", "side_effects", "risk", "verification"]}}
  }
}
