{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RunReportV1",
  "type": "object",
  "required": ["schema_version", "plan_ref", "started_at", "completed_at", "nodes", "replans_used", "final_status", "conclusion"],
  "properties": {
    "schema_version": {"const": "RunReportV1"},
    "replans_used": {"type": "integer", "minimum": 0, "maximum": 1},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "artifacts", "validation_evidence", "errors", "attempts"],
        "properties": {
          "status": {"enum": ["pending", "running", "succeeded", "failed", "blocked", "skipped"]},
          "attempts": {"type": "integer", "minimum": 1, "maximum": 2}
        }
      }
    }
  }
}
